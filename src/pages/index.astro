---
import BaseLayout from '../layouts/BaseLayout.astro';
import MetricCard from '../components/MetricCard.astro';
import ReportCard from '../components/ReportCard.astro';
import { getCollection } from 'astro:content';
import sigs from '../data/sigs.json';
import { BASE } from '../lib/site.js';
import { TrendingUp, Building2, FileText, UserPlus } from 'lucide-astro';

const reportEntries = await getCollection('reports');
const reports = [];

const sigCards = sigs.map((sig) => ({
  ...sig,
  charterUrl: `https://github.com/AtlasVanguard-ma/governance/blob/main/${sig.repoPath}CHARTER.md`,
}));
---

<BaseLayout
  title="Home"
  description="AtlasVanguard is a Moroccan financial observability initiative focused on transparent and reproducible research infrastructure."
>
  <section class="page-frame site-shell">
    <div class="hero-panel surface">
      <div class="hero-grid">
        <div class="headline-block">
          <h1>AtlasVanguard</h1>
          <h2>Moroccan Financial Observability &amp; Market Intelligence</h2>
          <p class="page-intro">
            Build transparent and reproducible financial observability infrastructure for Morocco’s evolving markets, enabling structured understanding of derivatives dynamics, market structure, and systemic behavior.
          </p>
          <div class="inline-links">
            <a href={`${BASE}project/`} class="cta-link">Explore the project</a>
            <a href="https://github.com/AtlasVanguard-ma/governance" target="_blank" rel="noopener noreferrer">Governance model → GitHub governance repo</a>
          </div>
        </div>
        <aside class="hero-aside">
          <p class="small-note">
            Public outputs are organized as reports, RFCs, and SIG workstreams. The site privileges readability, replication, and institutional continuity over promotional language.
          </p>
        </aside>
      </div>
    </div>

    <section class="rule-section">
      <div class="section-title-row">
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <TrendingUp size={24} stroke-width={1.5} style="color: var(--gold); flex-shrink: 0; margin-top: 2px;" />
          <h2 style="margin: 0;">Why Morocco now?</h2>
        </div>
      </div>
      <div class="two-col">
        <article class="card surface">
          <span class="eyebrow">The Transition</span>
          <h3>Loi n° 42-12 and the new observability burden</h3>
          <p>
            As derivatives structures enter the market, institutions need a clearer view of volatility regimes, cross-asset correlation, and the channels through which systemic risk can accumulate. Monitoring can no longer stop at price levels or simple turnover summaries.
          </p>
          <p class="muted">
            AtlasVanguard treats this as a research and transparency problem first: measure the market, document the method, and keep the output reproducible.
          </p>
        </article>
        <article class="card surface">
          <span class="eyebrow">Our Response</span>
          <h3>Modular infrastructure with governed collaboration</h3>
          <p>
            The initiative combines public methodology, structured reporting, and SIG-based workstreams so contributors can work in a durable institution rather than an ad hoc project. That model supports peer review, continuity, and explicit accountability.
          </p>
          <p class="muted">
            Every output should be traceable to a known method, a known SIG, and a known governance path.
          </p>
        </article>
      </div>
    </section>

    <section class="rule-section">
      <div class="section-title-row">
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <Building2 size={24} stroke-width={1.5} style="color: var(--teal); flex-shrink: 0; margin-top: 2px;" />
          <h2 style="margin: 0;">Governance &amp; SIGs</h2>
        </div>
        <a href={`${BASE}sigs/`}>View all SIGs</a>
      </div>
      <p class="content">
        AtlasVanguard is guided by a Steering Committee and organized into Special Interest Groups (SIGs).
      </p>
      <div class="card-grid cols-2">
        {sigCards.map((sig) => (
          <article class="card compact surface">
            <h3>{sig.name}</h3>
            <p class="muted">{sig.focus}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="rule-section">
      <div class="section-title-row">
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <FileText size={24} stroke-width={1.5} style="color: var(--gold); flex-shrink: 0; margin-top: 2px;" />
          <h2 style="margin: 0;">Latest Reports</h2>
        </div>
        <a href={`${BASE}reports/`}>Browse reports</a>
      </div>
      <div class="card-list tight">
        {reports.length > 0 ? (
          reports.map((report) => <ReportCard report={report} reportUrl={`/reports/${report.slug}/`} />)
        ) : (
          <p class="muted">No reports yet</p>
        )}
      </div>
    </section>

    <section class="rule-section">
      <article class="card surface">
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <UserPlus size={24} stroke-width={1.5} style="color: var(--teal); flex-shrink: 0; margin-top: 2px;" />
          <h2 style="margin: 0;">Join through a structured intake process</h2>
        </div>
        <p>
          Contributors apply through the membership form, are reviewed against the initiative’s research and engineering focus, and then join the Slack workspace after acceptance.
        </p>
        <div class="inline-links">
          <a href={`${BASE}contribute/`}>Membership and onboarding</a>
          <a href="https://docs.google.com/forms/d/e/1FAIpQLSf3-1hb6cY9J7ClfZIyjDZiUm_W6vpb5KEUl-1e2r6fi2-p8Q/viewform" target="_blank" rel="noopener noreferrer">Application form</a>
        </div>
      </article>
    </section>
  </section>
</BaseLayout>
