---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Users, Target, Layers } from 'lucide-astro';

const roles = [
  {
    title: 'Finance & market professionals',
    body: 'Traders, risk managers, analysts, portfolio strategists, and market specialists who understand how observability supports oversight and decision-making.',
  },
  {
    title: 'Quantitative researchers',
    body: 'Statisticians, econometricians, and financial engineers who can help turn data into defensible analysis.',
  },
  {
    title: 'Software & data engineers',
    body: 'People who build data pipelines, infrastructure, automation, and dependable operational tooling.',
  },
  {
    title: 'Regulators & policy analysts',
    body: 'Professionals who understand supervisory needs, market integrity, and the value of traceable public documentation.',
  },
  {
    title: 'Academics & students',
    body: 'Researchers, PhD candidates, and advanced Master’s students looking for a structured, real-world environment.',
  },
  {
    title: 'Communicators & designers',
    body: 'People who improve visualisation, technical writing, reporting, and how findings are understood by wider audiences.',
  },
];

const reasons = [
  {
    title: 'Work on real infrastructure',
    body: 'Contribute to a live observability pipeline that monitors Moroccan derivatives and market structure.',
  },
  {
    title: 'Cross-domain collaboration',
    body: 'Work alongside people from finance, engineering, research, and supervision, and learn from each other.',
  },
  {
    title: 'Build your public record',
    body: 'Public RFCs, reports, and code commits are attributable artifacts you can reference in your portfolio or institutional work.',
  },
];

const intake = [
  {
    step: 'Apply',
    body: 'Fill out the membership form and tell us about your background, interests, and the kinds of work you would like to support.',
  },
  {
    step: 'Review',
    body: 'The Steering Committee reviews applications for mission alignment, clarity, and where support will be most useful.',
  },
  {
    step: 'Onboard',
    body: 'Accepted members receive a Slack invitation and an initial guide or buddy. Your first weeks are about understanding the structure, meeting your SIG, and exploring ongoing work.',
  },
  {
    step: 'Integrate',
    body: 'Contribute at your own pace. You can observe, ask questions, and gradually take on tasks without pressure to produce immediately.',
  },
];

const ladder = [
  {
    title: 'Observer',
    body: 'Lurk, read reports, and learn the landscape.',
  },
  {
    title: 'Commenter',
    body: 'Ask questions, review drafts, and join discussions.',
  },
  {
    title: 'RFC Author',
    body: 'Propose changes or new analysis formally.',
  },
  {
    title: 'SIG Member',
    body: 'Join a Special Interest Group and contribute regularly.',
  },
  {
    title: 'Steering Committee',
    body: 'Take on oversight and institutional continuity.',
  },
];
---

<BaseLayout
  title="Join Us"
  description="Become part of Morocco’s open financial observability initiative through a structured, welcoming intake process."
>
  <section class="page-frame site-shell">
    <span class="page-kicker">Join Us</span>
    <div style="display: flex; align-items: center; gap: 0.5rem;">
      <Users size={32} stroke-width={1.5} style="color: var(--teal); flex-shrink: 0; margin-top: 2px;" />
      <h1 style="margin: 0;">Join Us</h1>
    </div>
    <p class="page-intro">Become part of Morocco’s first open financial observability initiative. Whatever your background, there is a place for you here.</p>

    <section class="rule-section">
      <article class="apply-card card surface">
        <span class="eyebrow">Membership application</span>
        <h2>Apply for Membership</h2>
        <p>
          Applications are reviewed regularly. You will receive a response within a few weeks.
        </p>
        <div class="inline-links">
          <a class="cta-link" href="https://docs.google.com/forms/d/e/1FAIpQLSf3-1hb6cY9J7ClfZIyjDZiUm_W6vpb5KEUl-1e2r6fi2-p8Q/viewform" target="_blank" rel="noopener noreferrer">Apply for Membership</a>
        </div>
      </article>
    </section>

    <section class="rule-section">
      <p>
        AtlasVanguard welcomes collaborators from finance, quantitative research, software, data, policy, academia, and communication disciplines. You do not need to know everything on day one. AtlasVanguard is a learning environment as much as a production one.
      </p>
    </section>

    <section class="rule-section">
      <h2>Who we are looking for</h2>
      <div class="role-grid">
        {roles.map((role) => (
          <article class="card surface role-card">
            <h3>{role.title}</h3>
            <p class="muted">{role.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="rule-section">
      <div style="display: flex; align-items: center; gap: 0.5rem;">
        <Target size={24} stroke-width={1.5} style="color: var(--gold); flex-shrink: 0; margin-top: 2px;" />
        <h2 style="margin: 0;">Why join?</h2>
      </div>
      <div class="reason-grid">
        {reasons.map((reason) => (
          <article class="card surface reason-card">
            <h3>{reason.title}</h3>
            <p class="muted">{reason.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="rule-section">
      <div style="display: flex; align-items: center; gap: 0.5rem;">
        <Layers size={24} stroke-width={1.5} style="color: var(--teal); flex-shrink: 0; margin-top: 2px;" />
        <h2 style="margin: 0;">How the intake works</h2>
      </div>
      <div class="intake-flow" aria-label="Membership intake process">
        {intake.map((item, index) => (
          <div class="intake-step">
            <div class="step-index">0{index + 1}</div>
            <div class="step-body">
              <h3>{item.step}</h3>
              <p>{item.body}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="accompaniment callout">
        <strong>New members are accompanied throughout the onboarding period.</strong>
        <p>You will not be left to figure things out alone.</p>
      </div>
    </section>

    <section class="rule-section">
      <h2>The collaboration environment</h2>
      <div class="card surface">
        <p>
          Slack is used for day-to-day coordination, operational communication, and early research exchange. It is not the system of record. Permanent decisions, RFCs, charters, and other durable artifacts live in the public GitHub governance repository.
        </p>
        <p>
          The channel structure is simple and traceable: <strong>#announcements</strong> for read-only governance updates, <strong>#general</strong> for coordination, and dedicated channels for each SIG. This keeps communication transparent and protects everyone’s work by separating discussion from decision.
        </p>
        <p class="muted">
          Governance and Slack rules are based on the official communication guidance in the public governance repository.
        </p>
      </div>
    </section>

    <section class="rule-section">
      <h2>Contribution ladder</h2>
      <div class="ladder">
        {ladder.map((step) => (
          <article class="ladder-step">
            <h3>{step.title}</h3>
            <p class="muted">{step.body}</p>
          </article>
        ))}
      </div>
      <p class="small-note">Every step is supported. No one moves forward alone.</p>
    </section>

    <section class="rule-section">
      <p class="muted">
        Already a member? Join the conversation on Slack and follow the governance repository for updates.
      </p>
    </section>
  </section>
</BaseLayout>

<style>
  .role-grid,
  .reason-grid {
    display: grid;
    gap: 0.9rem;
  }

  @media (min-width: 720px) {
    .role-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .reason-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .role-card h3,
  .reason-card h3 {
    margin-bottom: 0.45rem;
  }

  .muted {
    color: var(--text-muted);
  }

  .intake-flow {
    display: grid;
    gap: 0.8rem;
  }

  .intake-step {
    display: grid;
    gap: 0.8rem;
    align-items: start;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--border);
  }

  .intake-step:last-child {
    border-bottom: 0;
  }

  @media (min-width: 720px) {
    .intake-step {
      grid-template-columns: auto 1fr;
      align-items: center;
    }
  }

  .step-index {
    width: 2.1rem;
    height: 2.1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--gold);
    color: var(--gold);
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.95rem;
    flex-shrink: 0;
  }

  .step-body h3 {
    margin-bottom: 0.25rem;
  }

  .step-body p {
    margin: 0;
    color: var(--text-muted);
  }

  .callout {
    margin-top: 1rem;
    border-left: 4px solid var(--gold);
    padding: 0.9rem 1rem;
    background: var(--card);
    border-radius: 6px;
  }

  .callout p {
    margin: 0.25rem 0 0;
  }

  .ladder {
    position: relative;
    display: grid;
    gap: 0.85rem;
    padding-left: 1.1rem;
    margin-top: 0.5rem;
  }

  .ladder::before {
    content: '';
    position: absolute;
    left: 0.3rem;
    top: 0.15rem;
    bottom: 0.15rem;
    width: 2px;
    background: var(--gold);
    opacity: 0.65;
  }

  .ladder-step {
    position: relative;
    padding-left: 1rem;
  }

  .ladder-step::before {
    content: '';
    position: absolute;
    left: -0.02rem;
    top: 0.35rem;
    width: 0.7rem;
    height: 0.7rem;
    border: 1px solid var(--gold);
    background: var(--card);
    border-radius: 999px;
  }

  .ladder-step h3 {
    margin-bottom: 0.25rem;
  }

  .apply-card {
    border-left: 4px solid var(--gold);
  }
</style>