---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReportCard from '../components/ReportCard.astro';
import { getCollection } from 'astro:content';
import { BarChart3 } from 'lucide-astro';

const formatDate = (date) =>
  new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric' }).format(date);

const reportEntries = await getCollection('reports');
 const reports = [];

const categories = ['All', ...new Set(reports.map((report) => report.category))];
---

<BaseLayout
  title="Reports"
  description="AtlasVanguard publishes peer-reviewed, reproducible analysis of Moroccan financial markets."
>
  <section class="page-frame site-shell">
    <span class="page-kicker">Reports</span>
    <div style="display: flex; align-items: center; gap: 0.5rem;">
      <BarChart3 size={32} stroke-width={1.5} style="color: var(--gold); flex-shrink: 0; margin-top: 2px;" />
      <h1 style="margin: 0;">Research Reports &amp; Outputs</h1>
    </div>
    <p class="page-intro">Peer-reviewed, reproducible analysis of Moroccan financial markets.</p>

    <section class="rule-section">

      <p class="muted">No reports available yet.</p>
    </section>

    <script type="module">
      const select = document.querySelector('#report-filter');
      const items = Array.from(document.querySelectorAll('#report-list [data-category]'));

      if (select) {
        select.addEventListener('change', () => {
          const selected = select.value;
          items.forEach((item) => {
            const matches = selected === 'All' || item.dataset.category === selected;
            item.hidden = !matches;
          });
        });
      }
    </script>
  </section>
</BaseLayout>
